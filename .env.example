# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Recommended backup used when Gemini is busy or out of quota. Free key, no card: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=         (default: nvidia/nemotron-3.5-super-vl:free -> inclusionai/ling-3.2-flash:free -> openrouter/free)
# LLM_PROVIDER=openrouter   (skip Gemini, for testing the backup)

# Alternative backup. Needs a PAID Mistral plan
# (no free API tier as of Nov 2026), so leave it empty to stay on free tools.
MISTRAL_API_KEY=
# MISTRAL_MODEL=            (default: mistral-medium-latest -> mistral-small-latest)
# LLM_PROVIDER=mistral      (force Mistral only, for testing)

# Optional: pin specific models. By default the app tries
# gemini-3.6-flash -> gemini-3.5-flash -> gemini-3.8-flash -> gemini-3.7-flash,
# then any other Flash model the key can see.
# GEMINI_MODEL=
# GEMINI_SCREEN_MODEL=
# Optional: MINIMAL | LOW (default) | MEDIUM | HIGH. Higher = slower.
# GEMINI_THINKING_LEVEL=
